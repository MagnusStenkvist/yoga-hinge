[Unit]
Description=Yoga hinge angle to tablet-mode switch
After=systemd-udevd.service dbus.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/yoga-hinged
Restart=on-failure
RestartSec=3
StateDirectory=yoga-hinge
Environment=PYTHONUNBUFFERED=1

# Needs /dev/hidraw* and /dev/uinput, so no PrivateDevices.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
